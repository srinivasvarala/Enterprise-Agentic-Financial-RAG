# Copy to .env. Defaults in finrag/core/config.py match docker-compose.yml.
FINRAG_ENV=local
FINRAG_LOG_LEVEL=INFO
# FINRAG_DATABASE_URL=postgresql+psycopg://finrag:finrag@localhost:5432/finrag
# FINRAG_QDRANT_URL=http://localhost:6333
# FINRAG_S3_ENDPOINT_URL=http://localhost:8333
# FINRAG_OTEL_EXPORTER_ENDPOINT=http://localhost:6006/v1/traces

# Index adapters (ticket #4). Defaults are the real ones: Qdrant + Voyage + FastEmbed BM25.
# FINRAG_VECTOR_STORE_BACKEND=qdrant      # qdrant | memory (memory = not persisted)
# FINRAG_EMBEDDER_BACKEND=voyage          # voyage | hash (hash = offline fake, for tests/dev)
# FINRAG_SPARSE_BACKEND=fastembed         # fastembed | hash (hash = offline fake)
# FINRAG_QDRANT_COLLECTION=finrag_chunks
# Required when FINRAG_EMBEDDER_BACKEND=voyage (the API and worker fail fast without it):
# FINRAG_VOYAGE_API_KEY=
# FINRAG_VOYAGE_MODEL=voyage-finance-2
# FINRAG_VOYAGE_DIMENSION=1024            # must match the model; changing it needs a new collection
# FINRAG_FASTEMBED_BM25_MODEL=Qdrant/bm25 # downloaded on first use; cache dir via FINRAG_FASTEMBED_CACHE_DIR
# Offline local run with no API key: FINRAG_EMBEDDER_BACKEND=hash FINRAG_SPARSE_BACKEND=hash
